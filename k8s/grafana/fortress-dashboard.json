        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Alerts over time",
      "description": "When alerts happened, by severity",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (priority) (count_over_time({source=\"syscall\", priority=~\"$priority\"}[$__auto]))",
          "queryType": "range",
          "legendFormat": "{{priority}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Emergency"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Notice"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10m"
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Most frequent rules",
      "description": "Falco rules that fired the most",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(10, sum by (rule) (count_over_time({source=\"syscall\", priority=~\"$priority\"}[$__range])))",
          "queryType": "instant",
          "legendFormat": "{{rule}}",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "displayName": "${__field.labels.rule}"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Value/",
          "values": true
        },
        "minVizHeight": 28,
        "maxVizHeight": 36,
        "text": {
          "titleSize": 13,
          "valueSize": 18
        },
        "sizing": "manual"
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Where",
      "description": "Namespace and pod of each alert. Host processes and containers outside Kubernetes have no namespace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(15, sum by (namespace, pod) (count_over_time({source=\"syscall\", priority=~\"$priority\"} | regexp `k8s_ns_name=(?P<namespace>\\S+)` | regexp `k8s_pod_name=(?P<pod>\\S+)` | label_format namespace=`{{ if eq .namespace \"<NA>\" }}(host / outside Kubernetes){{ else }}{{ .namespace }}{{ end }}`, pod=`{{ if eq .pod \"<NA>\" }}-{{ else }}{{ .pod }}{{ end }}` [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Alerts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Alerts",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value #A": 2
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "Value #A": "Alerts"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Alert log",
      "description": "Every alert, newest first",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{source=\"syscall\", priority=~\"$priority\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "fortress",
    "security"
