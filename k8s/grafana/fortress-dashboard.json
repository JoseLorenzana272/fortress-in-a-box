  "description": "Real-time runtime security monitoring for the Fortress in a Box stack, powered by Falco + Loki.",
  "tags": ["fortress", "security", "falco"],
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "options": {
        "mode": "markdown",
        "content": "## 🛡️ Fortress Security Dashboard\nRuntime threat detection for this cluster — powered by **Falco** (syscall monitoring) and **Loki** (log aggregation). Data refreshes automatically; use the time picker (top right) to change the observation window."
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "id": 101,
      "panels": []
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Overall cluster security posture based on Critical/Warning/Error events in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "green", "index": 0, "text": "✓ SECURE — No Alerts" }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.000001,
                "to": 9999999,
                "result": { "color": "dark-red", "index": 1, "text": "⚠ ALERT — Review Required" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": 0 } ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 4 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum(count_over_time({priority=~\"Critical|Warning|Error\"}[$__range])) or vector(0)",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Cluster Status"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Total number of security events logged by Falco in the selected time range, regardless of severity.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": 0 } ] },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 4 },
      "id": 102,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum(count_over_time({source=\"syscall\"}[$__range])) or vector(0)",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Total Events Logged"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
